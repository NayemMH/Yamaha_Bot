# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="YOUR_APP_URL"

# SMTP Email Configuration for Sales Lead Dispatches
# Use your Gmail user and 16-character Google App Password (without spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Optional Meta WhatsApp Cloud API / CallMeBot Configuration
# If provided, server automatically sends WhatsApp messages directly via API
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
CALLMEBOT_API_KEY=""



# WhatsApp target representative
WHATSAPP_TARGET_PHONE=""
